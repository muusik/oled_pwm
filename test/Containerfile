# Debian 14 with what the laptop needs to build the module through DKMS:
# the running kernel's headers, the matching linux-source and dkms itself.
# The kernel image and initramfs-tools too, so that modprobe's choice of i915
# and the initramfs can be checked.
FROM docker.io/library/debian:forky
ARG KVER=7.2.15+deb14-amd64
# The apt-cacher-ng (test/build.sh: BL_APT_PROXY) comes as the build secret
# apt_proxy, as in bread_ladder: given to apt-get only, so it is neither in
# the image nor in the layer cache's key. http sources only: apt-cacher-ng
# refuses the CONNECT apt would use for https.
RUN --mount=type=secret,id=apt_proxy \
    p=$(cat /run/secrets/apt_proxy 2>/dev/null || true) \
 && o=${p:+"-o Acquire::http::Proxy=$p -o Acquire::https::Proxy=DIRECT"} \
 && apt-get $o update \
 && apt-get $o install -y --no-install-recommends \
      dkms linux-headers-${KVER} linux-source-7.2 patch xz-utils python3 kmod openssl \
      linux-image-${KVER} initramfs-tools linux-source linux-headers-amd64 \
 && rm -rf /var/lib/apt/lists/*
