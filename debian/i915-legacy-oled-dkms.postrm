#!/bin/sh
set -e

#DEBHELPER#

case "$1" in
remove)
	# The DKMS modules are gone (prerm): back to the stock i915 in the
	# initramfs of every kernel that has one.
	for f in /boot/initrd.img-*; do
		[ -e "$f" ] || continue
		k=${f#/boot/initrd.img-}
		[ -d "/lib/modules/$k" ] && update-initramfs -u -k "$k"
	done
	;;
esac

exit 0
